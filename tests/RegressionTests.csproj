<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <SourceDirectory Condition="'$(SourceDirectory)' == ''">../HaveIBeenPwnedKeePassPlugin</SourceDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SourceDirectory)/*.cs" Link="Plugin/%(Filename)%(Extension)" />
    <Reference Include="KeePass">
      <HintPath>../KeePass-2.X/KeePass.exe</HintPath>
    </Reference>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
</Project>
